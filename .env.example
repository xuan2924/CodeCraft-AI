# Copy to .env (ignored). Supply your own local database credentials.
# Values are literal, optionally single-quoted; no expansion or shell commands.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=codecraft
POSTGRES_PORT=5432
JAVA_PORT=8080
SANDBOX_PORT=9090
WEB_PORT=5173
# Required on an empty database only. Existing administrators are never overwritten.
# Account: 3-32 ASCII letters/digits/_/-; password: 8-128 Unicode code points.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Required, stable secret: 32 cryptographically random bytes encoded as 64 hex characters.
# Keep this key when restarting; do not use the bootstrap password as the key.
IDENTITY_FINGERPRINT_KEY=
# Optional. The Java launcher defaults this to http://localhost:<WEB_PORT>.
# PUBLIC_ORIGIN=http://localhost:5173
# Optional workspace publication. Generate the artifact with scripts/publish-problem.mjs first.
# The path is relative to the repository root (absolute paths are also accepted).
# Enabling publication requires a separate stable random 32-byte lowercase hex RPC secret.
# PROBLEM_PUBLICATION_FILE=.runtime/problem-publication.json
# SANDBOX_RPC_KEY=
