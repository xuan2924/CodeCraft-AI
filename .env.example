# Copy to .env (ignored). Supply your own local database credentials.
# Values are literal, optionally single-quoted; no expansion or shell commands.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=codecraft
POSTGRES_PORT=5432
JAVA_PORT=8080
SANDBOX_PORT=9090
WEB_PORT=5173
# Optional Redis: local JVM hints + PostgreSQL rate limits remain the defaults.
# Compose: set both backends to redis, supply REDIS_PASSWORD, then docker compose --profile redis up.
# Redis has no host port; REDIS_HOST/PORT apply to host-run Java only (use your own Redis).
REALTIME_BACKEND=local
RATE_LIMIT_BACKEND=postgresql
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# Reliable outbox always uses PostgreSQL. Optional broker separates interactive and slow consumers.
ASYNC_BACKEND=local
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=codecraft
# RABBITMQ_PASSWORD=
# Compose: ASYNC_BACKEND=rabbit + password; --profile redis --profile rabbit up
# Multi-sandbox (same Linux clock domain): add --profile sandbox-multi and set:
# SANDBOX_NODES=default@sandbox:9090,secondary@sandbox-secondary:9090
# Never repoint a bound node at a new empty volume. Stored storage identity fails closed.
# Host-run Java defaults to SANDBOX_HOST/SANDBOX_PORT when SANDBOX_NODES is empty.
SANDBOX_NODES=
WORKSPACE_EXECUTION_CONCURRENCY=4
SANDBOX_EXECUTION_CONCURRENCY=4
# Required on an empty database only. Existing administrators are never overwritten.
# Account: 3-32 ASCII letters/digits/_/-; password: 8-128 Unicode code points.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Required, stable secret: 32 cryptographically random bytes encoded as 64 hex characters.
# Keep this key when restarting; do not use the bootstrap password as the key.
IDENTITY_FINGERPRINT_KEY=
# Optional. The Java launcher defaults this to http://localhost:<WEB_PORT>.
# PUBLIC_ORIGIN=http://localhost:5173
# Optional workspace publication. Generate the artifact with scripts/publish-problem.mjs first.
# The path is relative to the repository root (absolute paths are also accepted).
# Enabling publication requires a separate stable random 32-byte lowercase hex RPC secret.
# PROBLEM_PUBLICATION_FILE=.runtime/problem-publication.json
# SANDBOX_RPC_KEY=
# Container CLI model access uses short-lived Java proxy grants, not provider keys.
# Compose fixes SANDBOX_LLM_HOST_URL=http://java:8080 in the trusted coordinator;
# it is not a .env setting. Do not add OPENAI_API_KEY / ANTHROPIC_API_KEY here.
# Optional Tavily Search/Extract service. Missing key means tools report unavailable.
# Dedicated service credits may be billed separately from user model tokens.
# Only Java receives this key; never put it in frontend or sandbox configuration.
# COPILOT_WEB_API_KEY=
# COPILOT_WEB_BASE_URL=https://api.tavily.com/
# COPILOT_WEB_TIMEOUT=20s
