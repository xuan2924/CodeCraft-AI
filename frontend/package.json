{
  "name": "codecraft-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": "24.9.0",
    "npm": "11.6.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.106.1",
    "naive-ui": "2.45.3",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    },
    "js-beautify": {
      "glob": "14.0.4"
    },
    "minimatch": "11.0.5"
  }
}
