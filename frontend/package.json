{
  "name": "codecraft-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": "24.9.0",
    "npm": "11.6.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "@lucide/vue": "1.73.0",
    "@tanstack/vue-query": "5.106.1",
    "@vueuse/core": "15.0.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "monaco-editor": "0.57.0",
    "motion-v": "2.12.0",
    "pinia": "3.0.4",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    },
    "js-beautify": {
      "glob": "14.0.4"
    },
    "minimatch": "11.0.5"
  }
}
